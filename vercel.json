{
  "redirects": [
    {
      "source": "/:old(portal|admin-dashboard|admin-portal|editor-portal|client-portal)",
      "destination": "https://dashboard.creativevision.dev/login",
      "permanent": false
    },
    {
      "source": "/:old(portal|admin-dashboard|admin-portal|editor-portal|client-portal)/:path*",
      "destination": "https://dashboard.creativevision.dev/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboards",
      "destination": "/dashboards/index.html"
    },
    {
      "source": "/book",
      "destination": "/book/index.html"
    },
    {
      "source": "/start",
      "destination": "/start/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/pricing/short-form",
      "destination": "/pricing/short-form/index.html"
    },
    {
      "source": "/pricing/long-form",
      "destination": "/pricing/long-form/index.html"
    },
    {
      "source": "/pricing/mixed",
      "destination": "/pricing/mixed/index.html"
    },
    {
      "source": "/join",
      "destination": "/join/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
